# Настройки IMAP подключения
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# Настройки FastAPI сервера
APP_NAME=Email Automation Platform
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Переменные для Docker Compose
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
DB_NAME=automation
DB_USER=automation
DB_PASSWORD=automation_secure_password

# Файловое хранилище
SAFE_STORAGE_DIR=./storage/safe
QUARANTINE_DIR=./storage/quarantine
MAX_FILE_SIZE_MB=50
LOG_DIR=./logs

# API для отправки данных (опционально)
API_ENDPOINT=https://your-api.example.com/invoices
API_KEY=your-secret-api-key
DEFAULT_PAGE_LIMIT=50
CLEANUP_DAYS_OLD=30
QUARANTINE_DAYS_OLD=7
LOGS_RETENTION_DAYS=90
ARCHIVE_DAYS_OLD=90
DATABASE_URL=postgresql://automation:automation_secure_password@localhost:5432/automation
REDIS_URL=redis://localhost:6379/0

# Настройки безопасности
ALLOWED_FILE_EXTENSIONS=.pdf,.xlsx,.docx,.xml
SCAN_INTERVAL_MINUTES=5

# CORS (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Parser tuning (не хранить реальные правила в git)
PARSER_RULES_ENABLED=true
PARSER_RULES_FILE=./config/parser_rules.local.json
PARSER_DEFAULT_CURRENCY=EUR
PARSER_DEFAULT_PARTNER_ID=unknown_partner
